# Variáveis públicas embutidas no bundle estático no momento do build.
# NEXT_PUBLIC_* aparecem no JS do navegador — não usar pra secrets.

# URL da Cloud Function criarLead (Firebase, região southamerica-east1)
NEXT_PUBLIC_LEAD_URL=https://criarlead-tm5jieohxa-rj.a.run.app

# Site Key do Cloudflare Turnstile (pública por exigência do Cloudflare)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADRIUqqVF9Elr6f8

# Plausible Analytics (opcional — descomentar quando criar conta).
# Sem cookies, LGPD-clean. Alternativa: Cloudflare Web Analytics (free).
# Doc: https://plausible.io/docs
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=escservicosautomotivos.com.br
