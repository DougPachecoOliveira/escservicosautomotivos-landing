# Configuração de email (Resend).
# Copia este arquivo para .env e edita os valores.
# .env é gitignored — não vai pro repo.

# === SANDBOX (sem domínio próprio verificado) ===
# Resend sandbox só envia pra emails verificados na conta. Coloque aqui
# o email com o qual você cadastrou a conta Resend (provavelmente o seu Gmail).
RESEND_TO=seu-email-de-cadastro@gmail.com

# Remetente em sandbox: obrigatoriamente onboarding@resend.dev
RESEND_FROM=ESC Site <onboarding@resend.dev>

# === PRODUÇÃO (quando domínio escservicosautomotivos.com.br for verificado) ===
# Comentar as 2 linhas acima e descomentar estas:
# RESEND_TO=atendimento@escservicosautomotivos.com.br
# RESEND_FROM=ESC Site <site@escservicosautomotivos.com.br>
